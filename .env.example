# Supabase — only needed for the multi-phone shared mode.
# Single-device mode works without these.
# Find them in Supabase → Project Settings → API.
# NEVER put the service_role key here: everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
